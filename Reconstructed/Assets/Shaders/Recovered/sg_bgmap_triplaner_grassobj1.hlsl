// Recovered from Shader Graphs/sg_bgmap_triplaner_grassobj1, Universal Forward ps (evidence/shader-recovery).
// An object textured with its own UV0 maps (ObjAlbed / ObjMetallic / ObjNormal), with world-space triplanar grass
// (Triplanar blend 1, grass tiling) laid over surfaces facing up: smoothstep of saturate(N.y) around
// _GrassAngle +- _GrassGradient, times a triplanar GlayScale.b mask through smoothstep(_GrassMask_Edge1, _GrassMask_Edge2)
// * _GrassMask_Int. Grass GlayScale packs metallic (R), occlusion (G), smoothness (A).
// Bytecode notes, kept as compiled:
//  - _ObjAlbed_Color is not referenced: the object albedo is the raw ObjAlbed sample.
//  - Object metallic = ObjMetallic.r, object smoothness = ObjMetallic.a * _ObjSmooth_Int.
//  - Occlusion = blend * grassGlayScale.g, i.e. the object part has occlusion 0 (lerp from a constant 0).
//  - Triplanar normals use Shader Graph's exact plane swizzle (TxA_TriplanarNormalSG below), not the shared helper,
//    whose X plane swaps the two tangent components relative to the bytecode.
CBUFFER_START(UnityPerMaterial)
    float4 _ObjAlbed_Color;
    float _ObjSmooth_Int;
    float _ObjNormal_Int;
    float _GrassGradient;
    float _GrassAngle;
    float4 _GrassAlbed_Color;
    float _GrassTiling;
    float _GrassmormalIntensity;
    float _GrassMask_Tiling;
    float _GrassMask_Edge1;
    float _GrassMask_Edge2;
    float _GrassMask_Int;
CBUFFER_END
TEXTURE2D(_ObjAlbed); SAMPLER(sampler_ObjAlbed);
TEXTURE2D(_ObjMetallic); SAMPLER(sampler_ObjMetallic);
TEXTURE2D(_ObjNormal); SAMPLER(sampler_ObjNormal);
TEXTURE2D(_GrassAlbed); SAMPLER(sampler_GrassAlbed);
TEXTURE2D(_GrassGlayScale); SAMPLER(sampler_GrassGlayScale);
TEXTURE2D(_GrassNormal); SAMPLER(sampler_GrassNormal);

// Shader Graph Triplanar (Normal type), as generated by Shader Graph 16 and seen in the bytecode.
float3 TxA_TriplanarNormalSG(TEXTURE2D_PARAM(tex, smp), float3 p, float3 n, float3 w)
{
    float3 x = UnpackNormal(SAMPLE_TEXTURE2D(tex, smp, p.zy));
    float3 y = UnpackNormal(SAMPLE_TEXTURE2D(tex, smp, p.xz));
    float3 z = UnpackNormal(SAMPLE_TEXTURE2D(tex, smp, p.xy));
    x = float3(x.xy + n.zy, abs(x.z) * n.x);
    y = float3(y.xy + n.xz, abs(y.z) * n.y);
    z = float3(z.xy + n.xy, abs(z.z) * n.z);
    return normalize(x.zyx * w.x + y.xzy * w.y + z.xyz * w.z);
}

void TxSurfaceFunction(TxSurfaceInput i, inout TxSurface s)
{
    float3 n = i.normalWS;
    float3x3 tbn = float3x3(i.tangentWS, i.bitangentWS, i.normalWS);
    float3 w = TxTriplanarWeights(n, 1);
    float3 pGrass = i.positionWS * _GrassTiling;
    float3 pMask = i.positionWS * _GrassMask_Tiling;
    float2 uv = i.uv0.xy;

    float3 obj = SAMPLE_TEXTURE2D(_ObjAlbed, sampler_ObjAlbed, uv).rgb;
    float3 grass = TxTriplanar(TEXTURE2D_ARGS(_GrassAlbed, sampler_GrassAlbed), pGrass, w).rgb * _GrassAlbed_Color.rgb;

    float mask = TxTriplanar(TEXTURE2D_ARGS(_GrassGlayScale, sampler_GrassGlayScale), pMask, w).b;
    mask = TxSmoothstep(_GrassMask_Edge1, _GrassMask_Edge2, mask) * _GrassMask_Int;
    float up = TxSmoothstep(_GrassAngle - _GrassGradient, _GrassAngle + _GrassGradient, saturate(n.y));
    float blend = mask * up;

    float3 objN = TxNormalStrength(UnpackNormal(SAMPLE_TEXTURE2D(_ObjNormal, sampler_ObjNormal, uv)), _ObjNormal_Int);
    float3 grassN = TransformWorldToTangent(TxA_TriplanarNormalSG(TEXTURE2D_ARGS(_GrassNormal, sampler_GrassNormal), pGrass, n, w), tbn);
    grassN = TxNormalStrength(grassN, _GrassmormalIntensity);

    float4 objM = SAMPLE_TEXTURE2D(_ObjMetallic, sampler_ObjMetallic, uv);
    float4 grassM = TxTriplanar(TEXTURE2D_ARGS(_GrassGlayScale, sampler_GrassGlayScale), pGrass, w);

    s.albedo = lerp(obj, grass, blend);
    s.normalWS = TxTangentToWorld(lerp(objN, grassN, blend), i);
    s.metallic = saturate(lerp(objM.r, grassM.r, blend));
    s.smoothness = saturate(lerp(objM.a * _ObjSmooth_Int, grassM.a, blend));
    s.occlusion = min(blend * grassM.g, 1);
}
