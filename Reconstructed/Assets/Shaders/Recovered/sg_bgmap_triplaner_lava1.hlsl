// Recovered from Shader Graphs/sg_bgmap_triplaner_lava1, Universal Forward ps (evidence/shader-recovery).
// Triplanar lava ground (Triplanar blend 1, world space, or object space when _ObjectSpace != 0).
//  Albedo: Blend(Difference, opacity 0.75) of Albed with Glayscale.b, times _Albed_Color.
//  Glayscale packs metallic (R), occlusion (G), smoothness (A * _Smmoth).
//  Normal: triplanar normal map, tangent normal + (1 - _NormalIntensity) on every component (kept as compiled).
//  Emission: E = triplanar Emission * _Emiision_Color (HDR, sRGB-converted in a gamma project). A world-space
//  triplanar Simple Noise (Shader Graph 16 deterministic, scale _EmissionNoizSize, UV = posWS * 0.5 +
//  _EmissionNoizeScloll, weights N^2) is passed through smoothstep(0.2, 0.8); B = luminance(E) * 10 * that mask;
//  emission = Blend(Overlay, base E, blend B, opacity 1). So the lava glows in noisy hot patches.
// The bytecode reads no time value: the noise "scroll" is a static offset (it only moves if a script animates
// _EmissionNoizeScloll on the material). The noise always uses world position/normal even when _ObjectSpace is on.
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Hashes.hlsl"

CBUFFER_START(UnityPerMaterial)
    float4 _Albed_Color;
    float _Tiling;
    float _Smmoth;
    float _NormalIntensity;
    float4 _Emiision_Color;
    float _ObjectSpace;
    float _EmissionNoizSize;
    float _EmissionNoizeScloll;
CBUFFER_END
TEXTURE2D(_Albed); SAMPLER(sampler_Albed);
TEXTURE2D(_Glayscale); SAMPLER(sampler_Glayscale);
TEXTURE2D(_Normal); SAMPLER(sampler_Normal);
TEXTURE2D(_Emission); SAMPLER(sampler_Emission);

// Shader Graph Triplanar (Normal type), as generated by Shader Graph 16 and seen in the bytecode.
float3 TxA_TriplanarNormalSG(TEXTURE2D_PARAM(tex, smp), float3 p, float3 n, float3 w)
{
    float3 x = UnpackNormal(SAMPLE_TEXTURE2D(tex, smp, p.zy));
    float3 y = UnpackNormal(SAMPLE_TEXTURE2D(tex, smp, p.xz));
    float3 z = UnpackNormal(SAMPLE_TEXTURE2D(tex, smp, p.xy));
    x = float3(x.xy + n.zy, abs(x.z) * n.x);
    y = float3(y.xy + n.xz, abs(y.z) * n.y);
    z = float3(z.xy + n.xy, abs(z.z) * n.z);
    return normalize(x.zyx * w.x + y.xzy * w.y + z.xyz * w.z);
}

// Shader Graph HDR colour property: IsGammaSpace() ? LinearToSRGB(c) : c.
float3 TxA_HDRColor(float3 c)
{
#ifdef UNITY_COLORSPACE_GAMMA
    return LinearToSRGB(c);
#else
    return c;
#endif
}

// Shader Graph 16 Simple Noise node, Deterministic hash (Hash_Tchou_2_1).
float TxA_ValueNoise(float2 uv)
{
    float2 i = floor(uv);
    float2 f = frac(uv);
    f = f * f * (3.0 - 2.0 * f);
    float r0, r1, r2, r3;
    Hash_Tchou_2_1_float(i + float2(0, 0), r0);
    Hash_Tchou_2_1_float(i + float2(1, 0), r1);
    Hash_Tchou_2_1_float(i + float2(0, 1), r2);
    Hash_Tchou_2_1_float(i + float2(1, 1), r3);
    return lerp(lerp(r0, r1, f.x), lerp(r2, r3, f.x), f.y);
}
float TxA_SimpleNoise(float2 uv, float scale)
{
    return TxA_ValueNoise(uv * scale) * 0.125
         + TxA_ValueNoise(uv * (scale * 0.5)) * 0.25
         + TxA_ValueNoise(uv * (scale * 0.25)) * 0.5;
}

void TxSurfaceFunction(TxSurfaceInput i, inout TxSurface s)
{
    bool objectSpace = _ObjectSpace != 0;
    float3 n = objectSpace ? TransformWorldToObjectNormal(i.normalWS) : i.normalWS;
    float3 p = (objectSpace ? i.positionOS : i.positionWS) * _Tiling;
    float3 w = TxTriplanarWeights(n, 1);
    float3x3 tbn = float3x3(i.tangentWS, i.bitangentWS, i.normalWS);

    float3 albedo = TxTriplanar(TEXTURE2D_ARGS(_Albed, sampler_Albed), p, w).rgb;
    float4 m = TxTriplanar(TEXTURE2D_ARGS(_Glayscale, sampler_Glayscale), p, w);
    albedo = lerp(albedo, abs(m.b - albedo), 0.75); // Blend Difference, opacity 0.75
    albedo *= _Albed_Color.rgb;

    float3 tn = TransformWorldToTangent(TxA_TriplanarNormalSG(TEXTURE2D_ARGS(_Normal, sampler_Normal), p, n, w), tbn);
    tn = tn + (1 - _NormalIntensity);

    // Emission with world-space triplanar noise hot spots.
    float3 e = TxTriplanar(TEXTURE2D_ARGS(_Emission, sampler_Emission), p, w).rgb * TxA_HDRColor(_Emiision_Color.rgb);
    float lum = dot(e, float3(0.299, 0.587, 0.114)) * 10;
    float3 nw = i.normalWS * i.normalWS; // |N|^2 weights (sum to 1)
    float2 nuvX = i.positionWS.yz * 0.5 + _EmissionNoizeScloll;
    float2 nuvY = i.positionWS.xz * 0.5 + _EmissionNoizeScloll;
    float2 nuvZ = i.positionWS.xy * 0.5 + _EmissionNoizeScloll;
    float noise = TxA_SimpleNoise(nuvX, _EmissionNoizSize) * nw.x
                + TxA_SimpleNoise(nuvY, _EmissionNoizSize) * nw.y
                + TxA_SimpleNoise(nuvZ, _EmissionNoizSize) * nw.z;
    float b = lum * TxSmoothstep(0.2, 0.8, noise);
    float3 overlayLo = 2.0 * e * b;
    float3 overlayHi = 1.0 - 2.0 * (1.0 - e) * (1.0 - b);
    float3 emission = lerp(overlayHi, overlayLo, step(e, 0.5)); // step(Base, 0.5) as in Shader Graph

    s.albedo = albedo;
    s.normalWS = TxTangentToWorld(tn, i);
    s.metallic = saturate(m.r);
    s.smoothness = saturate(m.a * _Smmoth);
    s.occlusion = min(m.g, 1);
    s.emission = emission;
}
