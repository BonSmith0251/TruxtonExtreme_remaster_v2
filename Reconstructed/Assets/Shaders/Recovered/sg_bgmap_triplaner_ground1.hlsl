// Recovered from Shader Graphs/sg_bgmap_triplaner_ground1, Universal Forward ps (evidence/shader-recovery).
// One triplanar ground layer (Triplanar blend 1) in world space, or in object space when _ObjectSpace != 0 (object
// position + TransformWorldToObjectNormal). Albedo = TexAlbed * _Albed_Color; GlayScale packs metallic (R),
// occlusion (G), smoothness (A * _Smmoth); triplanar normal map; emission = triplanar TexEmission * _Emission_Color
// (HDR colour: Shader Graph converts it to sRGB in a gamma-space project). Alpha = vertex colour alpha (the graph is
// Transparent, SrcAlpha/OneMinusSrcAlpha, ZWrite off), used to fade the ground's edges.
// Bytecode notes: the tangent-space normal is doubled before going back to world space (no effect after normalize,
// kept as compiled). Triplanar normals use Shader Graph's exact plane swizzle (TxA_TriplanarNormalSG).
CBUFFER_START(UnityPerMaterial)
    float4 _Albed_Color;
    float _Tiling;
    float _ObjectSpace;
    float _Smmoth;
    float4 _Emission_Color;
CBUFFER_END
TEXTURE2D(_TexAlbed); SAMPLER(sampler_TexAlbed);
TEXTURE2D(_TexGlayScale); SAMPLER(sampler_TexGlayScale);
TEXTURE2D(_TexNormal); SAMPLER(sampler_TexNormal);
TEXTURE2D(_TexEmission); SAMPLER(sampler_TexEmission);

// Shader Graph Triplanar (Normal type), as generated by Shader Graph 16 and seen in the bytecode.
float3 TxA_TriplanarNormalSG(TEXTURE2D_PARAM(tex, smp), float3 p, float3 n, float3 w)
{
    float3 x = UnpackNormal(SAMPLE_TEXTURE2D(tex, smp, p.zy));
    float3 y = UnpackNormal(SAMPLE_TEXTURE2D(tex, smp, p.xz));
    float3 z = UnpackNormal(SAMPLE_TEXTURE2D(tex, smp, p.xy));
    x = float3(x.xy + n.zy, abs(x.z) * n.x);
    y = float3(y.xy + n.xz, abs(y.z) * n.y);
    z = float3(z.xy + n.xy, abs(z.z) * n.z);
    return normalize(x.zyx * w.x + y.xzy * w.y + z.xyz * w.z);
}

// Shader Graph HDR colour property: IsGammaSpace() ? LinearToSRGB(c) : c.
float3 TxA_HDRColor(float3 c)
{
#ifdef UNITY_COLORSPACE_GAMMA
    return LinearToSRGB(c);
#else
    return c;
#endif
}

void TxSurfaceFunction(TxSurfaceInput i, inout TxSurface s)
{
    bool objectSpace = _ObjectSpace != 0;
    float3 n = objectSpace ? TransformWorldToObjectNormal(i.normalWS) : i.normalWS;
    float3 p = (objectSpace ? i.positionOS : i.positionWS) * _Tiling;
    float3 w = TxTriplanarWeights(n, 1);
    float3x3 tbn = float3x3(i.tangentWS, i.bitangentWS, i.normalWS);

    float3 albedo = TxTriplanar(TEXTURE2D_ARGS(_TexAlbed, sampler_TexAlbed), p, w).rgb * _Albed_Color.rgb;
    float4 m = TxTriplanar(TEXTURE2D_ARGS(_TexGlayScale, sampler_TexGlayScale), p, w);
    float3 tn = TransformWorldToTangent(TxA_TriplanarNormalSG(TEXTURE2D_ARGS(_TexNormal, sampler_TexNormal), p, n, w), tbn) * 2;
    float3 emission = TxTriplanar(TEXTURE2D_ARGS(_TexEmission, sampler_TexEmission), p, w).rgb * TxA_HDRColor(_Emission_Color.rgb);

    s.albedo = albedo;
    s.normalWS = TxTangentToWorld(tn, i);
    s.metallic = saturate(m.r);
    s.smoothness = saturate(m.a * _Smmoth);
    s.occlusion = min(m.g, 1);
    s.emission = emission;
    s.alpha = saturate(i.color.a);
}
